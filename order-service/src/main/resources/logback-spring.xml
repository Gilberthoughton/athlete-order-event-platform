<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logging to stdout (one JSON object per line) so logs are ready for ingestion by
  Loki/ELK and so the per-request correlationId (set by CorrelationIdFilter, carried on the MDC)
  appears on every line. Run locally with `| jq` for readability.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"order-service"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
