<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logging to stdout. The consumer puts the inbound event's correlationId on the
  MDC while processing, so a downstream log line correlates with the order that produced the event.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"inventory-consumer"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
